# Copy this file to .env.local and change what you need. Never put secrets here:
# everything in a VITE_ variable ends up in the website that anyone can download.

# Where the FastAPI backend runs (no / at the end)
VITE_API_URL=http://localhost:8000

# Face login: keep this off until the backend part works
# (Manuel's AI, Eszter's face_crypto.py and the face_login table)
VITE_FACE_LOGIN=false
