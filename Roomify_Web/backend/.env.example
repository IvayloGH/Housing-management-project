# Copy this file to .env and fill in real values. Never commit .env.

# ---- Database (Azure SQL Server) ----
DB_SERVER=your-server-name.database.windows.net
DB_PORT=1433
DB_NAME=your-database-name
DB_USER=your-username
DB_PASSWORD=your-password
DB_DRIVER=ODBC Driver 18 for SQL Server

# ---- Auth / JWT ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional; comma-separated React development/deployed origins
# On Azure also add the website, e.g. https://studenthousingpwa.z1.web.core.windows.net (no / at the end)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
